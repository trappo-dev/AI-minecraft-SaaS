# Environment Variables - TrappolaGIoDev
# Copy this to .env.local and fill in your actual values

# ============================================
# SUPABASE (Required)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# STRIPE (Required for Phase 3)
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Subscription Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ULTRA=price_...

# Stripe Credit Pack Price IDs (one-time payments)
# Pack 50 credits  → €4.99
STRIPE_PRICE_ID_PACK_50=price_...
# Pack 150 credits → €12.99
STRIPE_PRICE_ID_PACK_150=price_...
# Pack 500 credits → €39.99
STRIPE_PRICE_ID_PACK_500=price_...

# ============================================
# OPENROUTER (Required for Phase 5-6)
# ============================================
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
